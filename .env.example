# Example environment variables (do NOT commit real secrets)

# Optional: enables the "Import from Google Drive" button.
# Create an OAuth 2.0 Client ID (Web application) and an API key in a Google
# Cloud project with the Drive API and Picker API enabled, then add this
# app's dev/prod URL(s) to the OAuth client's Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
